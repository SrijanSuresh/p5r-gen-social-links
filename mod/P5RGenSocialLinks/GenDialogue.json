{
  // P5R Generative Social Links — runtime configuration
  // Edit this file to tune inference behaviour without recompiling.

  // URL of the Python inference server
  "server_url": "http://127.0.0.1:8765",

  // Minimum seconds between consecutive LLM calls in one hang-out session.
  // Lower = more frequent generation; must be > LLM latency (~2s on RTX 4060).
  "throttle_seconds": 3.0,

  // Seconds before an in-flight LLM request is abandoned.
  // First call after model load needs ~15s (CUDA JIT warmup); subsequent ~2s.
  "timeout_seconds": 30.0,

  // How often (ms) the session-change poll loop runs.
  "poll_interval_ms": 500,

  // Diagnostics for the offset-discovery era: struct field diffs, BF instruction dumps,
  // the per-message session dumps (BndScan / D0Direct / SessHeapPtrs), and the mapped-file
  // and UTF-16 heap sweeps.
  //
  // Keep false during play. The sweeps run every poll tick and scan tens of megabytes
  // each, which is enough to stutter the game, and the dialogue pool write path does not
  // depend on any of it. Turn on only when a pool stops being found.
  "struct_diff_enabled": false,

  // Master switch for writing generated text into the game's dialogue pool.
  // Set false to run the full pipeline (session, msgId, LLM) while touching no game
  // memory — the log still shows every generated line. Try this first if the game
  // becomes unstable: if the crashes stop, the write is the cause.
  "pool_write_enabled": true,

  // How many top-ranked heap regions to overwrite. This is a blast radius, not a retry
  // count — every armed region is written in full. Three regions wrote 211 slots and
  // included a data table ("ternTableOffset: -1") that ranked highest without being
  // dialogue. Keep at 1 unless diagnosing why the scene is not being found.
  "max_write_regions": 1,

  // How many records ahead of the player to keep generated.
  //
  // Generation takes ~2s and a held fast-forward button takes none, so the only way to
  // win that race is to start early. At 3, a line is written two or three bubbles before
  // the player reaches it. Raising it spends inference on records a branching scene may
  // never reach; the server handles one request at a time.
  //
  // 0 restores the old reactive behaviour (generate when the line is dispatched).
  "pregen_lookahead": 3,

  // Inject an assembly hook into the BMD message interpreter (P5R.exe+17A3D27) to
  // capture the record P5R is currently rendering, instead of inferring it by scanning
  // the heap and scoring regions for English.
  //
  // This is the most invasive thing the mod does: six instructions inside a loop that
  // runs once per character of every message in the game. If P5R fails to launch or
  // dies on the first line of dialogue, set this false first — the pool heuristic still
  // works without it.
  "msg_hook_enabled": true,

  // Log every pointer chain step with address + dereferenced value.
  // Enable when TryResolve() fails and you need to find the broken link.
  // Leave false in normal play — fires every 500ms poll tick.
  "verbose_chain": false,

  // Log verbosity: "info" (all messages), "warn" (errors/timeouts only), "off" (silent).
  "log_level": "info"
}
