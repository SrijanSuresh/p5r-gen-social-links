<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- This mod targets Windows-only P5R; suppress cross-platform scanner warning -->
    <NoWarn>CA1416</NoWarn>
    <!-- Bundle all NuGet deps alongside the DLL so Reloaded-II can find them -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>P5RGenSocialLinks</AssemblyName>
    <RootNamespace>P5RGenSocialLinks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="ModConfig.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Reloaded.Hooks removed: bundling it causes Reloaded.Memory version conflicts.
         The hooks implementation is provided by reloaded.sharedlib.hooks at runtime. -->
    <PackageReference Include="Reloaded.Hooks.Definitions" Version="1.15.0" />
    <PackageReference Include="Reloaded.Memory" Version="9.4.3" />
    <PackageReference Include="Reloaded.Memory.SigScan" Version="3.1.9" />
    <PackageReference Include="Reloaded.Mod.Interfaces" Version="2.5.0" />
  </ItemGroup>

  <!-- Deploy to the Reloaded-II mod folder on build.
       Reloaded loads the DLL from its own Mods directory, not from bin/, so a successful
       build says nothing about what the game will actually load. A stale deploy cost a
       full play session: the log reported behaviour from a build two commits old and the
       symptoms were indistinguishable from a code bug.

       ContinueOnError: the DLL is locked while P5R is running, and a failed copy must
       not fail the build - it just means the game needs restarting to pick it up. -->
  <Target Name="DeployToReloaded" AfterTargets="Build">
    <PropertyGroup>
      <ReloadedModDir>$(USERPROFILE)\Desktop\Reloaded-II\Mods\P5GenSocialLinks</ReloadedModDir>
    </PropertyGroup>
    <Copy SourceFiles="@(None);$(TargetPath)"
          DestinationFolder="$(ReloadedModDir)"
          Condition="Exists('$(ReloadedModDir)')"
          ContinueOnError="WarnAndContinue" />
    <Message Importance="high"
             Text="Deployed $(TargetFileName) -&gt; $(ReloadedModDir)"
             Condition="Exists('$(ReloadedModDir)')" />
  </Target>

</Project>
